    "slug": "bible-journey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/TBJA2.png",
    "userInterfaceStyle": "automatic",
    "scheme": "biblejourney",

    "ios": {
      "bundleIdentifier": "com.kuyaceds.biblejourney",
      "supportsTablet": true
    },

