        "foregroundImage": "./assets/TBJA2.png",
        "backgroundColor": "#080B18"
      }
    },

    "web": {
      "output": "static",
      "name": "Bible Journey",
      "shortName": "Bible Journey"
    },

    "experiments": {
      "baseUrl": "/BibleJourney"
    },

    "plugins": ["expo-notifications", "expo-font"],

    "extra": {
      "eas": {
        "projectId": "d464ac11-ee15-4746-afc0-e8c4262140aa"
      }
    },

    "owner": "kuyaceds_03"
  }
